# Copy to .env.local for local work, and add the same values to the Vercel project.
# Never commit real values. See docs/portal-setup.md for where each one comes from.

# ── Founder's Education portal: browser ──────────────────────────────────────
# Firebase console > Project settings > General > Your apps > Web app.
# These identify the project and are safe to expose to the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Founder's Education portal: server only ──────────────────────────────────
# Firebase console > Project settings > Service accounts > Generate new private key.
# These are secrets. They must never start with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the key on one line, keeping the \n sequences, wrapped in double quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Comma-separated emails of the portal admins. An account is an admin only if it
# is on this list AND was given the admin role by `npm run portal:setup`.
PORTAL_ADMIN_EMAILS=first.chair@uci.edu,second.chair@uci.edu

# Local demo only (`npm run portal:dev`). Adds your own address as a demo admin,
# with the demo password. Put it in .env.local, which is never committed.
# PORTAL_DEMO_ADMINS=you@uci.edu

# ── Blog (existing) ──────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
